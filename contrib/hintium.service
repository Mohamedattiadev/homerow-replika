[Unit]
Description=hintium keyboard hint daemon
Documentation=file://%h/hintium/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Matches the clone path the README's Install section uses. Adjust both
# lines if you cloned hintium somewhere else.
ExecStart=%h/hintium/bin/hintium --daemon
ExecStop=%h/hintium/bin/hintium --quit
Restart=on-failure
RestartSec=2
# The daemon needs the X display and the accessibility bus of the running
# session; a user unit does not inherit them from the login shell.
Environment=DISPLAY=:0
Slice=session.slice

[Install]
WantedBy=graphical-session.target
