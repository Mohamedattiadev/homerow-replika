[Unit]
Description=homerow keyboard hint daemon
Documentation=file://%h/homerow-replika/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Matches the clone path the README's Install section uses. Adjust both
# lines if you cloned homerow-replika somewhere else.
ExecStart=%h/homerow-replika/bin/homerow --daemon
ExecStop=%h/homerow-replika/bin/homerow --quit
Restart=on-failure
RestartSec=2
# The daemon needs the X display and the accessibility bus of the running
# session; a user unit does not inherit them from the login shell.
Environment=DISPLAY=:0
Slice=session.slice

[Install]
WantedBy=graphical-session.target
